OPENAI_API_KEY=

# Optional platform fallback only. Prefer per-tenant OpenAI keys
# (Admin → store detail, merchant Settings, or WP AI Assistant settings).

# Persist SQLite across Render deploys (attach a Disk, then set this path)
# Example Render disk mount: /var/data
APP_DB=/var/data/app.db

# Do NOT enable on Render unless you intentionally want to seed from JSON.
# TENANTS_MIGRATE=1 re-imports tenants.json into an empty DB (can resurrect old stores).
# TENANTS_MIGRATE=0
# TENANTS_BACKUP=0

# Optional: auto-register one WooCommerce store on startup
STORE_ID=my-store-001
WC_STORE_URL=https://your-store.com
WC_CONSUMER_KEY=ck_xxx
WC_CONSUMER_SECRET=cs_xxx
WC_STORE_NAME=My Store

# Admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Public backend URL (required for Shopify OAuth + webhooks + iframe login cookies)
APP_URL=https://your-backend.example.com

# Shopify app (Partners → Apps → API credentials)
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers,read_content,read_product_listings
SHOPIFY_API_VERSION=2024-10
